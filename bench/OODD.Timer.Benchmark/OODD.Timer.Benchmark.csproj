<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>OODD.Timer.Benchmark</RootNamespace>
    <AssemblyName>OODD.Timer.Benchmark</AssemblyName>
    <IsPackable>false</IsPackable>
    <OoddIsTool>true</OoddIsTool>
    <!-- 基准测试要贴近生产：工作站 GC、不变体上下文、禁止并行度干扰 -->
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <ConcurrentGarbageCollection>true</ConcurrentGarbageCollection>
    <TieredPGO>true</TieredPGO>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\OODD.Timer\OODD.Timer.csproj" />
  </ItemGroup>

</Project>
